    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase": "^13.2.0",
    "lucide-react": "^1.68.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "vite": "^6.4.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
