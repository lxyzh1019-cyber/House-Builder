{
  "name": "house-designer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "build:local": "NODE_OPTIONS=--max-old-space-size=6144 VITE_STORE=local vite build",
    "preview": "vite preview",
